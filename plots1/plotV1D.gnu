 unset surf 
 set ylabel 'V / E_H' rotate by 90
 set output "V1D_24_1.eps"
 set terminal postscript eps enhanced color
 set xlabel "q_{24} (Bu)"
 plot "V1D_24_1.dat"  using 1:2 with lines
